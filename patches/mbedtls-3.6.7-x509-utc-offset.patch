+#if defined(CICAA_X509_UTC_OFFSET)
+    /* CIC AA only: legacy HU UTCTime with explicit numeric timezone.
+     * Convert the parsed fields, never the original signed DER/TBS bytes.
+     * No time_t/mktime dependency (QNX clock and 2038 range are irrelevant).
+     */
+    if (tag == MBEDTLS_ASN1_UTC_TIME && len == 17) {
+        const unsigned char *value = *p;
+        int hours, minutes, utc_minutes;
+        if (value[12] != '+' && value[12] != '-') {
+            return MBEDTLS_ERR_X509_INVALID_DATE;
+        }
+        hours = x509_parse2_int(value + 13);
+        minutes = x509_parse2_int(value + 15);
+        if (hours < 0 || hours > 23 || minutes < 0 || minutes > 59) {
+            return MBEDTLS_ERR_X509_INVALID_DATE;
+        }
+        ret = x509_parse_time(value, tm, 2);
+        if (ret != 0) {
+            return ret;
+        }
+        utc_minutes = tm->hour * 60 + tm->min +
+                      (value[12] == '+' ? -1 : 1) * (hours * 60 + minutes);
+        if (utc_minutes < 0) {
+            utc_minutes += 24 * 60;
+            if (--tm->day == 0) {
+                if (--tm->mon == 0) {
+                    tm->mon = 12;
+                    --tm->year;
+                }
+                if (tm->year < 0) {
+                    return MBEDTLS_ERR_X509_INVALID_DATE;
+                }
+                tm->day = 31;
+                while (x509_date_is_valid(tm) != 0) {
+                    --tm->day;
+                }
+            }
+        } else if (utc_minutes >= 24 * 60) {
+            utc_minutes -= 24 * 60;
+            ++tm->day;
+            if (x509_date_is_valid(tm) != 0) {
+                tm->day = 1;
+                if (++tm->mon == 13) {
+                    tm->mon = 1;
+                    ++tm->year;
+                }
+            }
+        }
+        tm->hour = utc_minutes / 60;
+        tm->min = utc_minutes % 60;
+        ret = x509_date_is_valid(tm);
+        if (ret == 0) {
+            *p += len;
+        }
+        return ret;
+    }
+#endif /* CICAA_X509_UTC_OFFSET */
